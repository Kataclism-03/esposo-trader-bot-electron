{
  "name": "esposo-trader-bot",
  "version": "3.0.0",
  "description": "Bot de Trading para IQ Option y Exnova - Versión Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "build-all": "node scripts/build.js --all",
    "dist": "electron-builder --publish=never",
    "clean": "rimraf dist/ data/",
    "test": "echo \"Tests no implementados\" && exit 0"
  },
  "keywords": ["trading", "bot", "iq-option", "exnova", "electron", "javascript"],
  "author": "Esposo Trader",
  "license": "MIT",
  "homepage": "https://github.com/esposotrader/bot",
  "repository": {
    "type": "git",
    "url": "https://github.com/esposotrader/bot.git"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "axios": "^1.6.0",
    "ws": "^8.18.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "electron-builder": "^24.6.0",
    "rimraf": "^3.0.2"
  },
  "build": {
    "appId": "com.esposotrader.bot",
    "productName": "Esposo Trader Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "services/**/*", 
      "config/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraFiles": [
      "README.md",
      "INSTRUCCIONES_DE_USO.md",
      ".env.example"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg", 
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}