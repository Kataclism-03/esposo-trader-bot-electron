# Variables de entorno para Esposo Trader Bot
# Renombra este archivo a .env y configura tus valores

# Credenciales del broker (IQ Option / Exnova)
IQ_EMAIL=tu_email@ejemplo.com
IQ_PASSWORD=tu_password_secreto

# Configuración de Telegram (opcional, ya configurado en config.js)
# TELEGRAM_BOT_TOKEN=tu_bot_token
# TELEGRAM_CHAT_ID=tu_chat_id

# Configuración de desarrollo (opcional)
# NODE_ENV=development
# DEBUG=true